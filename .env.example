# ──────────────────────────────────────────────────────────────
# Nest Fan Optimizer — environment variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Generated by running: python get_token.py
GOOGLE_REFRESH_TOKEN=your-refresh-token

# From Device Access Console (device-access.nest.google.com)
# It looks like: 1a2b3c4d-5e6f-7890-abcd-ef1234567890
SDM_PROJECT_ID=your-device-access-project-id

# ──────────────────────────────────────────────────────────────
# Tuning (all optional — defaults shown)
# ──────────────────────────────────────────────────────────────

# Quiet hours — fan won't run between these times (24h format)
FAN_QUIET_START=22:00
FAN_QUIET_END=06:30

# Run fan when floor-to-floor temp difference exceeds this (°F)
TEMP_DELTA_THRESHOLD_F=3.0

# How often to check temperatures (seconds). 900 = 15 minutes.
POLL_INTERVAL_SECONDS=900

# How long to run the fan each cycle (seconds). 1200 = 20 minutes.
# Set slightly longer than POLL_INTERVAL_SECONDS so there's no gap.
FAN_RUN_DURATION_SECONDS=1200

# ──────────────────────────────────────────────────────────────
# Experiment: rotate daily through alternative fan-control strategies
# ──────────────────────────────────────────────────────────────
# CONCLUDED 2026-07-11: duty_cycle (15 on / 15 off) won a 5-week A/B test
# against higher_threshold_9F and burst — best balance of runtime savings
# (~56% less than the old always-on control) and comfort, with the most
# consistent results across a 74-93°F outdoor range. Neither challenger arm
# beat it. duty_cycle is now the permanent default (EXPERIMENT_ENABLED=false
# below); the rotation machinery is left in place, dormant, in case a future
# strategy is worth testing. See hub.py: arm_for_date(), decide_fan_mode().
# Check the active arm any time at /api/experiment or on the /status dashboard.

# Set to "false" to disable rotation entirely (always run duty_cycle default)
EXPERIMENT_ENABLED=false

# Change this salt to reshuffle the whole schedule (e.g. if you change arm list).
# Phase 1 (Jun 8-26): nest-fan-arms-v1  arms=[control, higher_threshold, burst, duty_cycle]
# Phase 2 (Jun 27+):  nest-fan-arms-v2  arms=[burst, higher_threshold]  default=duty_cycle
EXPERIMENT_SEED_SALT=nest-fan-arms-v2

# "higher_threshold" arm: run the duty-cycle pattern only when Δ exceeds this.
# Phase 1 used 6.0°F (non-binding — 5/6 days saved nothing). Phase 2 uses 9.0°F
# which is near the daily p90 and should gate meaningfully on well-mixed days.
EXPERIMENT_HIGH_THRESHOLD_F=9.0

# "burst" arm: only allow the fan to run during the first N minutes after
# quiet hours end — tests whether most of the benefit happens in the morning
# ramp-up (per the event-study "elbow") and the rest of the day's runtime is
# largely wasted.
EXPERIMENT_BURST_MINUTES=120

# "duty_cycle" arm: alternate fixed on/off windows (minutes) all day instead
# of running continuously whenever above threshold — tests whether short
# pulses sustain most of the mixing benefit for a fraction of the runtime.
EXPERIMENT_DUTY_ON_MINUTES=15
EXPERIMENT_DUTY_OFF_MINUTES=15
