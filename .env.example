# ──────────────────────────────────────────────────────────────
# Nest Fan Optimizer — environment variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Generated by running: python get_token.py
GOOGLE_REFRESH_TOKEN=your-refresh-token

# From Device Access Console (device-access.nest.google.com)
# It looks like: 1a2b3c4d-5e6f-7890-abcd-ef1234567890
SDM_PROJECT_ID=your-device-access-project-id

# ──────────────────────────────────────────────────────────────
# Tuning (all optional — defaults shown)
# ──────────────────────────────────────────────────────────────

# Quiet hours — fan suppressed between these times (24h format).
# BLANK BY DEFAULT, deliberately: the evening/overnight window is when the
# compressor works hardest (77-91% duty, 18:00-24:00) and when the basement
# reservoir is deepest (11-12F), so suppressing the fan there was blocking
# the highest-value cooling hours of the day. Set both to re-enable.
FAN_QUIET_START=
FAN_QUIET_END=

# Minimum floor-to-floor difference before circulating is considered (°F).
# Note this is now a floor, not the objective — see the comfort section below.
TEMP_DELTA_THRESHOLD_F=3.0

# ──────────────────────────────────────────────────────────────
# Comfort objective (the current goal)
# ──────────────────────────────────────────────────────────────
# Hold the occupied rooms below COMFORT_MAX_F using basement air, so the
# compressor runs less. The fan runs only when BOTH are true:
#   1. an occupied room is within COMFORT_DEADBAND_F of the cap, and
#   2. the basement is at least MIN_GRADIENT_F cooler than that room.
# Condition 2 matters: circulating when the gradient has collapsed just runs
# the blower for nothing.

COMFORT_MAX_F=74.0
COMFORT_DEADBAND_F=1.5
MIN_GRADIENT_F=3.0

# Which sensors count as "occupied rooms" and which as the cold reservoir,
# matched on the location prefix the hub resolves each device to.
OCCUPIED_PREFIX=upstairs
RESERVOIR_PREFIX=basement

# Which room actually matters, by time of day.
#   HH:MM-HH:MM=location[@cap_f]; ...     (windows may wrap midnight)
#
# Without this the hub optimises for whichever upstairs room is hottest —
# often the empty office at 3am. Note the two rooms sit on opposite sides of
# the thermostat: the living room measures ~0.6F HOTTER than the hallway by
# day (peaking +2.5F) while the master bedroom runs 0.3-1.0F COOLER, so one
# thermostat target cannot serve both periods.
#
# @cap overrides COMFORT_MAX_F for that window — sleeping comfort is often a
# lower ceiling than daytime, e.g.
#   22:00-07:00=upstairs: master bedroom@70
OCCUPANCY_SCHEDULE=07:00-20:00=upstairs: living room@74; 20:00-07:00=upstairs: master bedroom@70

# ──────────────────────────────────────────────────────────────
# Thermostat setpoint control (OFF by default)
# ──────────────────────────────────────────────────────────────
# Normally the hub only touches the fan. Turn this on and it also drives the
# cool setpoint on a schedule. Opt-in deliberately: it changes how the house
# feels for everyone living in it, not just what the blower does.
#
# Targets are derived from the measured hallway bias, not from the comfort
# caps directly — the living room reads hotter than the thermostat and the
# bedroom cooler, so the target is offset from the room ceiling in opposite
# directions.
#
# Pick the target so the room lands just UNDER its cap, not well below it.
# 72F was tried first and left the living room 1.5-2F below its 74F cap for
# most of the day: comfortable, but the compressor was cooling past what
# comfort needed, and the fan's comfort gate (cap minus deadband) almost never
# fired, so circulation had nothing to do. 73F floats the room into the band
# where the fan is actually exercised.
SETPOINT_CONTROL_ENABLED=false
SETPOINT_SCHEDULE=07:00-20:00=73; 20:00-07:00=70

# Safety rails:
#   UNTIL      auto-expiry (YYYY-MM-DD, blank = never). Prefer setting this —
#              a trial that lapses on its own beats one that runs forever
#              because nobody remembered to turn it off.
#   MIN/MAX    hard clamp applied at the command itself; no schedule typo can
#              send something wild.
#   TOLERANCE  the Nest stores Celsius in 0.5-degree steps, so a commanded
#              value reads back slightly different. Anything within this is
#              "already correct" rather than a change to re-issue.
SETPOINT_CONTROL_UNTIL=
SETPOINT_MIN_F=68.0
SETPOINT_MAX_F=76.0
SETPOINT_TOLERANCE_F=0.6

# A manual change always wins: if the setpoint is ever something the hub did
# not command, that's a person overriding it, so the hub stands down for the
# rest of that window and resumes at the next transition. The override is
# logged, which also makes it a comfort-failure data point rather than noise.

# How often to check temperatures (seconds). 900 = 15 minutes.
POLL_INTERVAL_SECONDS=900

# How long to run the fan each cycle (seconds). 1200 = 20 minutes.
# Set slightly longer than POLL_INTERVAL_SECONDS so there's no gap.
FAN_RUN_DURATION_SECONDS=1200

# ──────────────────────────────────────────────────────────────
# Experiment: rotate daily through alternative fan-control strategies
# ──────────────────────────────────────────────────────────────
# CONCLUDED 2026-07-11: duty_cycle (15 on / 15 off) won a 5-week A/B test
# against higher_threshold_9F and burst — best balance of runtime savings
# (~56% less than the old always-on control) and comfort, with the most
# consistent results across a 74-93°F outdoor range. Neither challenger arm
# beat it. duty_cycle is now the permanent default (EXPERIMENT_ENABLED=false
# below); the rotation machinery is left in place, dormant, in case a future
# strategy is worth testing. See hub.py: arm_for_date(), decide_fan_mode().
# Check the active arm any time at /api/experiment or on the /status dashboard.

# Set to "false" to disable rotation entirely (always run duty_cycle default)
EXPERIMENT_ENABLED=false

# Change this salt to reshuffle the whole schedule (e.g. if you change arm list).
# Phase 1 (Jun 8-26): nest-fan-arms-v1  arms=[control, higher_threshold, burst, duty_cycle]
# Phase 2 (Jun 27+):  nest-fan-arms-v2  arms=[burst, higher_threshold]  default=duty_cycle
EXPERIMENT_SEED_SALT=nest-fan-arms-v2

# "higher_threshold" arm: run the duty-cycle pattern only when Δ exceeds this.
# Phase 1 used 6.0°F (non-binding — 5/6 days saved nothing). Phase 2 uses 9.0°F
# which is near the daily p90 and should gate meaningfully on well-mixed days.
EXPERIMENT_HIGH_THRESHOLD_F=9.0

# "burst" arm: only allow the fan to run during the first N minutes after
# quiet hours end — tests whether most of the benefit happens in the morning
# ramp-up (per the event-study "elbow") and the rest of the day's runtime is
# largely wasted.
EXPERIMENT_BURST_MINUTES=120

# "duty_cycle" arm: alternate fixed on/off windows (minutes) all day instead
# of running continuously whenever above threshold — tests whether short
# pulses sustain most of the mixing benefit for a fraction of the runtime.
EXPERIMENT_DUTY_ON_MINUTES=15
EXPERIMENT_DUTY_OFF_MINUTES=15
